{
  "name": "vouchify-tron-contracts",
  "version": "0.1.0",
  "private": true,
  "description": "TronBox-based deployment and validation workspace for Vouchify Solidity contracts on TRON.",
  "scripts": {
    "compile": "tronbox compile --all",
    "migrate:shasta": "tronbox migrate --network shasta --reset --compile-all",
    "migrate:nile": "tronbox migrate --network nile --reset --compile-all",
    "migrate:mainnet": "tronbox migrate --network mainnet --reset --compile-all",
    "test": "tronbox test --network development",
    "flatten:voucher": "tronbox flatten src/core/VouchifyVoucher.sol",
    "derive:key": "node script/deriveTronKeyFromMnemonic.js",
    "send:usdt:shasta": "node script/sendShastaUsdt.js"
  },
  "dependencies": {
    "@openzeppelin/contracts": "^5.6.1",
    "dotenv": "^17.4.2",
    "tronweb": "^6.2.2"
  },
  "devDependencies": {
    "tronbox": "^4.6.0"
  }
}