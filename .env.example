TRON_SHASTA_RPC_URL=https://api.shasta.trongrid.io
TRON_NILE_RPC_URL=https://nile.trongrid.io
TRON_MAINNET_RPC_URL=https://api.trongrid.io

# TronBox reads PRIVATE_KEY as a string and the config normalizes both
# 64-char hex keys and 0x-prefixed hex keys.
# TRON_MNEMONIC is optional and only used by the local derive:key utility.
# Keep it local and never commit a real seed phrase.
TRON_MNEMONIC=
PRIVATE_KEY=
ADMIN_WALLET=
COLD_WALLET=

# Validation inputs for script/ValidateTronTestnet.s.sol
# Tron USDT is the only ERC-20 token used by Vouchify on Tron.
# If you are validating on Shasta, set TRON_USDT_TOKEN to the Shasta USDT contract you already fund.
# VALIDATION_BUYER is any nonzero address that will receive the minted voucher and membership
# during validation. It does not need to spend USDT in this script; the deployer pays the tx fees.
TRON_USDT_TOKEN=
VALIDATION_BUYER=
# VALIDATION_MERCHANT_ID is the off-chain backend merchant id written into the contracts.
# It is not tied to the on-chain Merchant Registry for the Tron validation flow.
VALIDATION_MERCHANT_ID=1
VALIDATION_PAYMENT_AMOUNT=1000000
VALIDATION_MEMBERSHIP_CREDITS=10

# Optional provider credential. Kept in env because some Shasta endpoints enforce rate limits,
# but TronBox network config itself still uses fullHost URLs from the official docs.
TRONGRID_API_KEY=
TRONSCAN_API_KEY=
PRIVATE_KEY_SHASTA=
PRIVATE_KEY_NILE=